<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.LunarForgeMarket" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/c_bg</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/c_topbar</item>
        <!-- No white strip under the gesture bar: navigation bar matches the app's dark background. -->
        <item name="android:navigationBarColor">@color/c_bg</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_system_bars</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">@bool/light_system_bars</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:navigationBarDividerColor" tools:targetApi="28">@android:color/transparent</item>
        <item name="colorPrimary">#287BFF</item>
        <item name="colorAccent">#287BFF</item>
        <item name="appAccent">#287BFF</item>
        <!-- Скруглённые всплывающие меню, выпадающие списки и диалоги во всём приложении -->
        <item name="android:popupMenuStyle">@style/LunarPopupMenu</item>
        <item name="popupMenuStyle">@style/LunarPopupMenuCompat</item>
        <item name="spinnerStyle">@style/LunarSpinner</item>
        <item name="alertDialogTheme">@style/LunarDialog</item>
    </style>

    <!-- лето: морская бирюза (белый текст на кнопке 3.68:1, акцент на тёмном фоне 4.63:1) -->
    <style name="Theme.LunarForgeMarket.Teal">
        <item name="colorPrimary">#0891B2</item>
        <item name="colorAccent">#0891B2</item>
        <item name="appAccent">#0891B2</item>
    </style>

    <!-- осень: тёплый оранжевый (3.56:1 и 4.79:1) -->
    <style name="Theme.LunarForgeMarket.Orange">
        <item name="colorPrimary">#EA580C</item>
        <item name="colorAccent">#EA580C</item>
        <item name="appAccent">#EA580C</item>
    </style>

    <style name="Theme.LunarForgeMarket.Purple">
        <item name="colorPrimary">#8B5CF6</item>
        <item name="colorAccent">#8B5CF6</item>
        <item name="appAccent">#8B5CF6</item>
    </style>

    <style name="Theme.LunarForgeMarket.Green">
        <item name="colorPrimary">#16A34A</item>
        <item name="colorAccent">#16A34A</item>
        <item name="appAccent">#16A34A</item>
    </style>

    <style name="Theme.LunarForgeMarket.Pink">
        <item name="colorPrimary">#EC4899</item>
        <item name="colorAccent">#EC4899</item>
        <item name="appAccent">#EC4899</item>
    </style>


    <!-- Меню скрепки в чате (системное PopupMenu) -->
    <style name="LunarPopupMenu" parent="@android:style/Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_rounded</item>
        <item name="android:popupElevation">8dp</item>
    </style>

    <style name="LunarPopupMenuCompat" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_rounded</item>
        <item name="android:popupElevation">8dp</item>
    </style>

    <!-- Выпадающие списки (тип товара, сортировка, подкатегория) -->
    <style name="LunarSpinner" parent="Widget.AppCompat.Spinner">
        <item name="android:popupBackground">@drawable/bg_popup_rounded</item>
        <item name="android:popupElevation">8dp</item>
    </style>

    <!-- Диалоговые окна (пополнение, вывод, отзыв, подтверждения) -->
    <style name="LunarDialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_rounded</item>
    </style>


    <!-- фильтры-«чипы» на экране заявок -->
    <style name="LunarChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_search_field</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">18dp</item>
        <item name="android:textColor">@color/c_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

</resources>
