<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_bg">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/c_topbar"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Назад"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- шапка: аватар + ник, тап открывает профиль собеседника -->
        <LinearLayout
            android:id="@+id/headerUser"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/headerAvatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/avatar_description"
                android:src="@drawable/ic_avatar_placeholder" />

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="220dp"
                android:text="Чат"
                android:textColor="@color/c_text"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/orderStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/c_strip"
        android:clickable="true"
        android:focusable="true"
        android:padding="14dp"
        android:text="Заказ #0 · открыть и подтвердить получение →"
        android:textColor="@color/c_warning"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messagesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel"
        app:layout_constraintTop_toBottomOf="@id/orderStrip" />

    <!-- Bottom panel: either the input row or the recording row is visible. -->
    <FrameLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/c_surface"
        android:minHeight="64dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/inputBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingVertical="8dp">

            <ImageButton
                android:id="@+id/attachButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Прикрепить фото или видео"
                android:padding="12dp"
                android:src="@drawable/ic_attach" />

            <EditText
                android:id="@+id/messageEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chat_input"
                android:hint="Сообщение"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="5"
                android:minHeight="48dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:textColor="@color/c_text"
                android:textColorHint="@color/c_text_hint"
                android:textSize="17sp" />

            <!-- Mic / camera: tap = switch mode, hold = record (Telegram style). -->
            <ImageButton
                android:id="@+id/recordButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Удерживайте для записи"
                android:padding="13dp"
                android:src="@drawable/ic_mic" />

            <!-- Shown instead of recordButton when there is text to send. -->
            <ImageButton
            android:tint="@color/c_on_accent"
                android:id="@+id/sendButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_record_button_active"
                android:contentDescription="Отправить"
                android:padding="14dp"
                android:src="@drawable/ic_send"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/recordingBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:visibility="gone">

            <!-- Visible only when locked: discard the recording. -->
            <ImageButton
                android:id="@+id/discardRecordingButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Удалить запись"
                android:padding="12dp"
                android:src="@drawable/ic_delete"
                android:visibility="gone" />

            <View
                android:id="@+id/recordDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_record_dot" />

            <TextView
                android:id="@+id/recordingTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="0:00"
                android:textColor="@color/c_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/slideToCancelText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="‹  Влево - отмена"
                android:textColor="@color/c_text_secondary"
                android:textSize="16sp" />

            <!-- Visible only when locked: stop and send. -->
            <ImageButton
            android:tint="@color/c_on_accent"
                android:id="@+id/sendRecordingButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_record_button_active"
                android:contentDescription="Отправить запись"
                android:padding="14dp"
                android:src="@drawable/ic_send"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <!-- Lock hint above the record button: slide your finger up to it to keep recording hands-free. -->
    <LinearLayout
        android:id="@+id/lockIndicator"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_lock_pill"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_lock_small" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginTop="4dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_up" />
    </LinearLayout>

    <!-- Video-note ("кружок") camera preview, shown while recording one. -->
    <FrameLayout
        android:id="@+id/noteOverlay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/c_overlay"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/notePreviewCircle"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="center">

            <androidx.camera.view.PreviewView
                android:id="@+id/notePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_note_preview_ring" />
        </FrameLayout>

        <!-- смена фронталка/задняя прямо во время записи (видно, если у телефона есть обе камеры) -->
        <TextView
            android:id="@+id/flipCameraButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:translationY="170dp"
            android:background="@drawable/bg_flip_button"
            android:clickable="true"
            android:contentDescription="Сменить камеру"
            android:focusable="true"
            android:gravity="center"
            android:text="🔄"
            android:textSize="24sp"
            android:visibility="gone" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
