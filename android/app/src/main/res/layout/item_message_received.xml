<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <!-- кто написал: аватар + ник над первым сообщением группы. тап - профиль -->
    <LinearLayout
        android:id="@+id/senderHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="3dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/senderAvatar"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/avatar_description" />

        <TextView
            android:id="@+id/senderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="240dp"
            android:textColor="?attr/appAccent"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- подпись сотрудника над сообщением: 👑 Админ ... / 🛡️ Модератор ... -->
    <TextView
        android:id="@+id/senderLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginBottom="2dp"
        android:textColor="?attr/appAccent"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/attachmentImageContainer"
        android:layout_width="200dp"
        android:layout_height="150dp"
        android:layout_gravity="start"
        android:background="@drawable/bg_message_received"
        android:visibility="gone">

        <ImageView
            android:id="@+id/attachmentImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- Inline playback surface for round video notes (TextureView clips to the circle). -->
        <TextureView
            android:id="@+id/noteTexture"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/videoPlayIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_play_circle"
            android:visibility="gone" />

        <!-- кольцо прогресса кружка: видно пока он играет/на паузе, по нему можно перематывать пальцем -->
        <com.lunarforge.market.ui.chat.NoteRingView
            android:id="@+id/noteRing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/voiceContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:background="@drawable/bg_message_received"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/voicePlayButton"
            android:tint="@color/c_text"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_play_circle" />

        <TextView
            android:id="@+id/voiceDurationText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="0:12"
            android:textColor="@color/c_text"
            android:textSize="14sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/messageText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:background="@drawable/bg_message_received"
        android:maxWidth="260dp"
        android:padding="12dp"
        android:text="Привет!"
        android:textColor="@color/c_text"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/timeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginTop="2dp"
        android:text="12:00"
        android:textColor="@color/c_text_hint"
        android:textSize="13sp" />

</LinearLayout>
