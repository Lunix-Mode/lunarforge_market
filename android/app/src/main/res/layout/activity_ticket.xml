<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/c_topbar"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back_button_description"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/c_text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- что за заявка, суммы, кто подал, кто ведёт -->
    <TextView
        android:id="@+id/ticketInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/rounded_bg"
        android:lineSpacingExtra="3dp"
        android:padding="14dp"
        android:textColor="@color/c_text_soft"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/claimButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_publish_product_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Взять заявку"
            android:textColor="@color/c_on_accent"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/resolveButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_field"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Вынести решение"
            android:textColor="?attr/appAccent"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/peopleButton"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_search_field"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="👤"
            android:textSize="20sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:text="Переписка участников"
        android:textColor="@color/c_text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messagesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp" />

    <!-- писать в чат может только ответственный -->
    <LinearLayout
        android:id="@+id/staffInputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/c_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/staffMessageEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_chat_input"
            android:hint="Вопрос участникам"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:minHeight="48dp"
            android:paddingHorizontal="16dp"
            android:textColor="@color/c_text"
            android:textColorHint="@color/c_text_hint"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/staffSendButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_record_button_active"
            android:contentDescription="Отправить"
            android:padding="14dp"
            android:src="@drawable/ic_send"
            android:tint="@color/c_on_accent" />
    </LinearLayout>
</LinearLayout>
