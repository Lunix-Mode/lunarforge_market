<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:text="Двигайте фото и приближайте двумя пальцами"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp" />

    <com.lunarforge.market.ui.profile.AvatarCropView
        android:id="@+id/cropView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/cancelCropButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_field"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Отмена"
            android:textColor="@color/c_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/doneCropButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_publish_product_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Готово"
            android:textColor="@color/c_on_accent"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
