<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_bg">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/c_topbar"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Назад"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Статус заказа"
            android:textColor="@color/c_text"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/statusCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@color/c_surface"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/statusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_pending"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Ожидает подтверждения"
                android:textColor="@color/c_warning"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/orderTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="1000 Robux"
                android:textColor="@color/c_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/orderAmountText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Сумма: 568 ₽ (заморожена)"
                android:textColor="?attr/appAccent"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/orderPartyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Продавец: nickname"
                android:textColor="@color/c_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/orderDateText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Создан: —"
                android:textColor="@color/c_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/orderHintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_hint_box"
                android:lineSpacingExtra="2dp"
                android:padding="14dp"
                android:textColor="@color/c_text_soft"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/openChatButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_search_field"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="💬 Чат"
                android:textColor="?attr/appAccent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/confirmButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_publish_product_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Подтвердить получение"
                android:textColor="@color/c_on_accent"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rateSellerButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_search_field"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="★ Оценить продавца"
                android:textColor="@color/c_star"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- заявка по заказу (возврат): статус, кто ведёт, решение -->
            <TextView
                android:id="@+id/ticketInfoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_delivery_method"
                android:lineSpacingExtra="2dp"
                android:padding="12dp"
                android:textColor="@color/c_text_soft"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/refundButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_search_field"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Запросить возврат"
                android:textColor="@color/c_warning"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/orderProblemButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_search_field"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="🧾 Проблема с заказом"
                android:textColor="@color/c_text_secondary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/cancelButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_search_field"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Отменить заказ"
                android:textColor="@color/c_danger"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
